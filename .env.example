# 공공데이터포털 일반 인증키 (Decoding 키 권장. Encoding 키를 넣어도 됨)
DATA_GO_KR_KEY=
# Supabase → Project Settings → Database → Connection string (URI). Session pooler 권장
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# 수집 범위 (기본: 서울 25구, 4유형, 최근 2개월)
# REGIONS=11680,11650,11710
# PROP_TYPES=apt,rh,sh,offi
# MONTHS_BACK=2
# MOLIT_APT_ENDPOINT=dev        # 상세 API 미승인이면 basic

# 호출 예산 (개발계정 1,000/일)
# MAX_CALLS=900

# 이슈 규칙
# TX_SPIKE_MIN=5
# TX_SPIKE_PCT=30
# COMPLEX_MIN=5
# ISSUE_TTL_HOURS=24
# REGIONS=                 # 실거래 수집 시군구 코드. 기본 서울 25 + 경기 44 전부
# TARGET_SGG=              # 경기 타겟 시군구 코드(콤마). 비우면 거래 상위 GYEONGGI_TARGET_N개 자동
# GYEONGGI_TARGET_N=8
# RECENT_TOP_DONGS_GG=6
# RECENT_TOP_COMPLEXES_GG=4
# BOOTSTRAP_QUIET_DAYS=7
# 계약일 기준 2주 리더보드 (첫날부터 유효): 상위 동네/단지 수, 단지 최소 건수, 카드 수명(일), 같은 카드 재등장 간격(일)
# RECENT_TOP_DONGS=8
# RECENT_TOP_COMPLEXES=5
# RECENT_COMPLEX_MIN=3
# RECENT_TTL_DAYS=7
# RECENT_REPEAT_DAYS=7

# 메일 (Gmail 앱 비밀번호). 둘 다 없으면 자동 dry-run(로그만)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_SENDER_NAME=정범기
# MAIL_DAILY_LIMIT=100
# MAIL_GAPS_DAYS=3,4,7
# MAIL_DRY_RUN=true

# 외부 노출 신호 (enrich). 없으면 그 단계만 건너뜀
KAKAO_REST_KEY=                 # developers.kakao.com → 내 애플리케이션 → REST API 키 (아웃리치 맵에 쓰던 키)
NAVER_CLIENT_ID=                # NAVER API HUB (console.ncloud.com → Application Services → NAVER API HUB) 인증 정보
NAVER_CLIENT_SECRET=
# NAVER_HUB=true                # 개발자센터 구키(2027-06 종료)면 false
# KAKAO_DAILY_BUDGET=3000
# NAVER_DAILY_BUDGET=1500   # 블로그 노출 수
# NAVER_LOCAL_BUDGET=1500   # 지역검색 상위 5
# ENRICH_EXTRA_REGIONS=15       # 이슈 없는 날 미리 채울 거래 상위 동네 수
# ENRICH_REFRESH_DAYS=30
# 제휴·금융 리드 수집 (카카오 로컬): 하루 호출 예산, 동네 갱신 주기(일), 검색 반경(m)
# PLACES_DAILY_BUDGET=6000
# PLACES_REFRESH_DAYS=30
# PLACES_RADIUS_M=1200
# 공개정보 메일 수집: 하루 리드 수, 페이지 예산, 재시도 주기(일), 자동 채택/후보 점수
# EMAIL_DAILY_LEADS=150
# EMAIL_PAGE_BUDGET=450
# EMAIL_REFRESH_DAYS=45
# EMAIL_MIN_AUTO=60
# EMAIL_MIN_CANDIDATE=40
# RANK_LEADS_MAX=20      # 이슈당 중개 리드 상한
# RANK_PARTNER_MAX=10    # 제휴 (세무사·조합·법무사·플랫폼·인플루언서)
# RANK_FINANCE_MAX=10    # 금융 (은행 지점 등)
